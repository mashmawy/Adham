<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Adham.Cli</RootNamespace>
    <AssemblyName>adham</AssemblyName>
    <!-- Installed as a global tool: `adham` from any folder, which becomes the working directory. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adham</ToolCommandName>
    <PackageId>Adham</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nupkgs</PackageOutputPath>
    <Description>Adham: a local-first coding agent for local LLMs (OpenAI-compatible backends such as Unsloth Studio).</Description>
    <PackageTags>ai;agent;llm;local;cli</PackageTags>
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Adham.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <ProjectReference Include="..\Adham.Common\Adham.Common.csproj" />
    <ProjectReference Include="..\Adham.Core\Adham.Core.csproj" />
    <ProjectReference Include="..\Adham.Tools.Files\Adham.Tools.Files.csproj" />
    <ProjectReference Include="..\Adham.Tools.Search\Adham.Tools.Search.csproj" />
    <ProjectReference Include="..\Adham.Tools.Shell\Adham.Tools.Shell.csproj" />
  </ItemGroup>
</Project>
